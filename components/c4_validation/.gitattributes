# Files that run inside Linux containers must keep LF endings on a Windows checkout.
*.sh    text eol=lf
*.sql   text eol=lf
*.ini   text eol=lf
*.conf  text eol=lf
Dockerfile text eol=lf
*.yml   text eol=lf

# Oracle records and reports are compared byte for byte across runs (NFR1).
*.json  text eol=lf
