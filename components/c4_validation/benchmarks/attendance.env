# Benchmark descriptor: Online Attendance Management System (see PINS.md).
# Everything the environment needs to know about this application lives here.
# The file name is the benchmark name: select it with C4_BENCHMARK=attendance.
C4_LEGACY_DOCROOT=./benchmarks/attendance/app
C4_LEGACY_SEED=./benchmarks/attendance/app/database/attsystem.sql
C4_LEGACY_DB_NAME=attsystem
# Written for PHP 5 and its mysql_* functions, which PHP 7 removed.
C4_LEGACY_PHP=5.6
C4_LEGACY_PHP_EXTENSIONS=mysql mysqli
