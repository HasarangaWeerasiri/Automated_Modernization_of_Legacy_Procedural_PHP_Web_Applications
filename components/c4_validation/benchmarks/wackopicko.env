# Benchmark descriptor: WackoPicko (see PINS.md).
# Everything the environment needs to know about this application lives here.
# The file name is the benchmark name: select it with C4_BENCHMARK=wackopicko.
C4_LEGACY_DOCROOT=./benchmarks/wackopicko/app/website
C4_LEGACY_SEED=./benchmarks/wackopicko/app/current.sql
C4_LEGACY_DB_NAME=wackopicko
# Written for PHP 5 and its mysql_* functions, which PHP 7 removed.
C4_LEGACY_PHP=5.6
C4_LEGACY_PHP_EXTENSIONS=mysql mysqli
